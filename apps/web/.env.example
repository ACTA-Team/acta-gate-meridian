# The backend. Defaults to the deployed one; use http://localhost:4000 for a local api.
NEXT_PUBLIC_API_URL=https://backend-gate.acta.build

# Required. The testnet account that pays for deploying each holder's passkey smart
# account (docs/deployments/acta-gate-testnet.md, "Deployer of the passkey smart accounts").
# It ships to the browser: testnet only, never a mainnet key.
NEXT_PUBLIC_DEPLOYER_SECRET=
