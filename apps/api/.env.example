PORT=4000
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet

ISSUER_NAME=GrantFox
TREASURY_NAME=GrantFox Treasury
VOTE_NAME=Contributor vote
REQUIRED_TIER=Gold

# Contract IDs default to packages/shared (docs/deployments/acta-gate-testnet.md).
# Set them only to point at another deployment.
# VAULT_FACTORY_ID=
# VC_GATE_ID=
# CREDENTIAL_POLICY_ID=
# CREDENTIAL_VOTE_ID=

# Required: the backend refuses to start without it.
# ACTA: sponsors holders' DIDs and vaults, and pays the fees of their passkey-signed calls.
SPONSOR_SECRET=

# Needed by the calls that use them; without them the wallet, DID and vault still work.
# Treasury smart account (C…) with the current credential-policy on its Default rule.
TREASURY_ADDRESS=
# GrantFox (GC7INDGA…EFA6): issues, registers in vc-gate, revokes. It must be this account:
# credential-vote and the policy were deployed to trust it.
ISSUER_SECRET=
# Ed25519 external signer of the treasury.
TREASURY_SIGNER_SECRET=
