PORT=4000
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet

# mock: the contracts' rules in memory (works today).
# testnet: calls the deployed contracts; needs everything below.
GATE_MODE=mock

ISSUER_NAME=GrantFox
TREASURY_NAME=Tesorería de GrantFox
REQUIRED_TIER=Gold

# --- testnet only ---
# Factory built with the vc-vault 0.5.0 template (spike PA). Not CB23E4GX…, that one is 0.4.0.
# VAULT_FACTORY_ID=
# VC_GATE_ID=
# CREDENTIAL_POLICY_ID=
# Treasury smart account (C…) with credential-policy on its Default rule (spike P8).
# TREASURY_ADDRESS=
# ACTA: sponsors holders' vaults.
# SPONSOR_SECRET=
# GrantFox: issues, registers in vc-gate, revokes.
# ISSUER_SECRET=
# Ed25519 external signer of the treasury.
# TREASURY_SIGNER_SECRET=
