PORT=4000
CORS_ORIGIN=http://localhost:3000
STELLAR_NETWORK=testnet

ISSUER_NAME=GrantFox
TREASURY_NAME=GrantFox Treasury
VOTE_NAME=Contributor vote
REQUIRED_TIER=Gold

# Contract IDs default to packages/shared (docs/deployments/acta-gate-testnet.md).
# Set them only to point at another deployment.
# VAULT_FACTORY_ID=
# VC_GATE_ID=
# CREDENTIAL_POLICY_ID=
# CREDENTIAL_VOTE_ID=

# Required. The backend refuses to start without them.
# Treasury smart account (C…) with the current credential-policy on its Default rule.
TREASURY_ADDRESS=
# ACTA: sponsors holders' vaults and pays the fees of their passkey-signed calls.
SPONSOR_SECRET=
# GrantFox: issues, registers in vc-gate, revokes.
ISSUER_SECRET=
# Ed25519 external signer of the treasury.
TREASURY_SIGNER_SECRET=
